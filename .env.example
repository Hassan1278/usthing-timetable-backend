# Description: Example of .env file
# Usage: Duplicate this file as .env and change as needed.

# MongoDB URI (optional; dev and tests fall back to an in-memory MongoDB).
MONGO_URI=mongodb://localhost:27018/template-api

# Optional: dedicated MongoDB URI used when running tests.
# MONGO_TEST_URI=mongodb://localhost:27018/template-api

# Skip token verification entirely (local development / tests).
AUTH_SKIP=false

# Request limits per API process. Shared counters are needed for multiple replicas.
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional Docker Compose host ports (services use fixed internal ports).
API_PORT=3000
MONGO_HOST_PORT=27018

# Local email capture: docker compose --profile reminders up --build -d --wait
MAILPIT_PORT=8025
# For a separately started worker, configure SMTP_HOST/PORT for its test inbox.
# SMTP port 1025 is internal to Compose; it is not published to the host.
EMAIL_DELIVERY_ENABLED=false
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=reminders@usthing.invalid
# SMTP_USER=
# SMTP_PASSWORD=
